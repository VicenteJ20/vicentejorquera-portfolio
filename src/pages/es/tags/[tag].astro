---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TagPage from '../../../components/pages/TagPage.astro';
import { useTranslations } from '../../../i18n/ui';
import { collectTags, getPosts } from '../../../utils/content';

export async function getStaticPaths() {
  const posts = await getPosts('es');
  return [...collectTags(posts).keys()].map((tag) => ({ params: { tag } }));
}

const t = useTranslations('es');
const { tag } = Astro.params;
---

<BaseLayout lang="es" title={`#${tag}`} description={t('meta.tagsDescription')}>
  <TagPage lang="es" tag={tag} />
</BaseLayout>
