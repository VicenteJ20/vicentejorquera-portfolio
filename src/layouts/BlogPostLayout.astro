---
/**
 * Blog post shell: article header (title, meta, tags), two-column layout
 * with sticky TOC on xl screens, share links, author box, prev/next nav.
 * Alternates (hreflang) may omit a side for untranslated posts.
 */
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SITE, type Lang } from '../consts';
import { useTranslations } from '../i18n/ui';
import { absoluteUrl, formatDate, getPosts, localizePath, readingTime, slugOf, tagSlug, type BlogPost } from '../utils/content';

interface Props {
  post: BlogPost;
  lang: Lang;
  alternates: { en?: string; es?: string };
  headings: { depth: number; slug: string; text: string }[];
}

const { post, lang, alternates, headings } = Astro.props;
const t = useTranslations(lang);

const slug = slugOf(post);
const url = localizePath(`/blog/${slug}/`, lang);
const ogImage = post.data.heroImage ?? `/og/${lang}/${slug}.png`;
const minutes = readingTime(post.body);

// Prev/next within the same language, by date
const posts = await getPosts(lang);
const index = posts.findIndex((p) => p.id === post.id);
const prev = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined; // older
const next = index > 0 ? posts[index - 1] : undefined; // newer

const shareUrl = absoluteUrl(url);
const shareText = post.data.title;
const shareX = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`;
const shareLinkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;

const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: absoluteUrl(ogImage),
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: lang === 'es' ? 'es-CL' : 'en-US',
  keywords: post.data.tags.join(', '),
  mainEntityOfPage: absoluteUrl(url),
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Person', name: SITE.name, url: SITE.url },
};
---

<BaseLayout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  tags={post.data.tags}
  alternates={alternates}
  jsonLd={blogPostingJsonLd}
>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="grid gap-10 py-12 sm:py-16 xl:grid-cols-[minmax(0,1fr)_240px] xl:gap-14">
      <article class="min-w-0">
        {/* Breadcrumb / back */}
        <a href={localizePath('/blog/', lang)} class="font-mono text-[11px] uppercase tracking-[0.2em] text-muted no-underline transition-colors hover:text-accent">{t('common.backToBlog')}</a>

        {/* Header */}
        <header class="mt-6">
          <h1 class="font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink sm:text-5xl">{post.data.title}</h1>
          <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10.5px] uppercase tracking-[0.16em] text-muted">
            <span>{t('common.published')}: <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time></span>
            {post.data.updatedDate && <span>{t('common.updated')}: <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate, lang)}</time></span>}
            <span>{minutes} {t('common.readingTime')}</span>
          </div>
          {post.data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => <a class="tag-pill" href={localizePath(`/tags/${tagSlug(tag)}/`, lang)}>{tagSlug(tag)}</a>)}
            </div>
          )}
        </header>

        {post.data.heroImage && (
          <figure class="mt-8">
            <img src={post.data.heroImage} alt={post.data.heroImageAlt ?? post.data.title} class="w-full rounded-2xl border border-line object-cover" loading="eager" decoding="async" />
          </figure>
        )}

        {/* Mobile TOC */}
        <details class="toc mt-8 rounded-xl border border-line bg-surface p-4 xl:hidden">
          <summary class="cursor-pointer select-none font-mono text-[10px] uppercase tracking-[0.22em] text-muted">{t('post.toc')}</summary>
          <div class="mt-3"><TableOfContents headings={headings} lang={lang} /></div>
        </details>

        {/* Body */}
        <div class="post-body mt-10">
          <slot />
        </div>

        {/* Divider + share */}
        <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
          <p class="font-display text-lg italic text-ink">{t('post.thanks')}</p>
          <div class="flex items-center gap-3">
            <a href={shareX} target="_blank" rel="noopener" aria-label={t('post.shareOnX')} class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-accent">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M4 4h3.6l5.1 7.3L18.7 4H21l-7.3 9.4L21.3 20h-3.6l-5.3-7.5L5.3 20H3l7.6-9.7L4 4Z"/></svg>
            </a>
            <a href={shareLinkedIn} target="_blank" rel="noopener" aria-label={t('post.shareOnLinkedIn')} class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-accent">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM4.5 9.75h1v11.25h-1zM10 9.75h.96v1.54h.01c.13-.25.46-.82 1.5-.82 1.6 0 2.65 1.04 2.65 3.01v7.52h-.99v-6.66c0-1.59-.58-2.68-2-2.68-1.5 0-2.13 1.09-2.13 2.68v6.66H10z"/></svg>
            </a>
          </div>
        </div>

        {/* Author box */}
        <div class="mt-6 flex items-center gap-4 rounded-2xl border border-line bg-surface p-5">
          <svg viewBox="0 0 40 40" width="52" height="52" class="shrink-0" aria-hidden="true"><rect width="40" height="40" rx="9" fill="var(--accent)"/><text x="20" y="27.5" text-anchor="middle" font-family="'Fraunces Variable', Georgia, serif" font-weight="650" font-size="23" fill="var(--btn-ink)">V</text></svg>
          <div class="min-w-0">
            <p class="font-display font-semibold text-ink">{SITE.name}</p>
            <p class="mt-0.5 text-sm leading-snug text-muted">{t('post.authorBio')}</p>
            <a href={SITE.github} target="_blank" rel="me noopener" class="mt-1.5 inline-block font-mono text-[10px] uppercase tracking-[0.18em] text-accent no-underline hover:text-accent-strong">github →</a>
          </div>
        </div>

        {/* Prev / next */}
        <nav class="mt-6 grid gap-4 sm:grid-cols-2" aria-label="Posts">
          {prev ? (
            <a href={localizePath(`/blog/${slugOf(prev)}/`, lang)} class="card card-hover group p-5 no-underline">
              <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-muted">{t('common.prevPost')}</span>
              <span class="mt-2 block font-display font-semibold leading-snug text-ink transition-colors group-hover:text-accent-strong line-clamp-2">{prev.data.title}</span>
            </a>
          ) : <span class="hidden sm:block"></span>}
          {next && (
            <a href={localizePath(`/blog/${slugOf(next)}/`, lang)} class="card card-hover group p-5 no-underline sm:text-right">
              <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-muted">{t('common.nextPost')}</span>
              <span class="mt-2 block font-display font-semibold leading-snug text-ink transition-colors group-hover:text-accent-strong line-clamp-2">{next.data.title}</span>
            </a>
          )}
        </nav>
      </article>

      {/* Sticky TOC — desktop only */}
      <aside class="hidden xl:block">
        <div class="sticky top-24"><TableOfContents headings={headings} lang={lang} /></div>
      </aside>
    </div>
  </div>

  {/* Mermaid: lazy-load and render only when the post contains diagrams */}
  <script>
    async function renderMermaidBlocks() {
      const blocks = Array.from(document.querySelectorAll('.post-body pre')) as HTMLElement[];
      let touched = false;
      for (const pre of blocks) {
        if (pre.dataset.mermaidDone) continue;
        const code = pre.querySelector('code');
        const cls = code?.getAttribute('class') ?? '';
        const dataLang = code?.getAttribute('data-language') ?? pre.getAttribute('data-language') ?? '';
        if (!/mermaid/i.test(`${cls} ${dataLang}`)) continue;
        const source = (code?.textContent ?? pre.textContent ?? '').trim();
        if (!source) continue;
        const holder = document.createElement('pre');
        holder.className = 'mermaid';
        holder.dataset.source = source;
        holder.textContent = source;
        pre.replaceWith(holder);
        touched = true;
      }
      const nodes = Array.from(document.querySelectorAll('.post-body .mermaid')) as HTMLElement[];
      if (nodes.length === 0) return;
      const mod = await import('mermaid');
      const mermaid = mod.default;
      const dark = document.documentElement.classList.contains('dark');
      mermaid.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'default', securityLevel: 'loose', fontFamily: "'Inter Variable', system-ui, sans-serif" });
      try { await mermaid.run({ nodes }); } catch (err) { console.warn('Mermaid render failed:', err); }
    }

    document.addEventListener('astro:page-load', renderMermaidBlocks);
    renderMermaidBlocks();

    // Re-render diagrams when the user flips the theme
    window.addEventListener('themechange', async () => {
      const nodes = Array.from(document.querySelectorAll('.post-body .mermaid')) as HTMLElement[];
      if (nodes.length === 0) return;
      for (const node of nodes) {
        const source = node.dataset.source;
        if (source) node.textContent = source;
      }
      const mod = await import('mermaid');
      const mermaid = mod.default;
      const dark = document.documentElement.classList.contains('dark');
      mermaid.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'default', securityLevel: 'loose' });
      try { await mermaid.run({ nodes: nodes as HTMLElement[] }); } catch (err) { console.warn('Mermaid re-render failed:', err); }
    });

    // TOC scroll spy
    function initTocSpy() {
      const links = Array.from(document.querySelectorAll('[data-toc-link]')) as HTMLAnchorElement[];
      if (links.length === 0 || !('IntersectionObserver' in window)) return;
      const map = new Map<string, HTMLAnchorElement>();
      for (const link of links) {
        const id = link.getAttribute('data-toc-link');
        if (id) map.set(id, link);
      }
      const headings = Array.from(document.querySelectorAll('.post-body h2[id], .post-body h3[id]'));
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          const link = map.get(entry.target.id);
          if (!link) continue;
          if (entry.isIntersecting) {
            links.forEach((l) => l.removeAttribute('aria-current'));
            link.setAttribute('aria-current', 'true');
          }
        }
      }, { rootMargin: '-20% 0px -65% 0px', threshold: 0 });
      headings.forEach((h) => observer.observe(h));
    }
    document.addEventListener('astro:page-load', initTocSpy);
    initTocSpy();
  </script>
</BaseLayout>
