---
/**
 * BaseLayout — SEO/OG head, theme bootstrap, header/footer shell.
 * Every page renders through this.
 */
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import { SITE, type Lang } from '../consts';
import { alternatePaths, absoluteUrl } from '../utils/content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  /** Page-specific title; rendered as `<title> · Vicente Jorquera`. Omit on home. */
  title?: string;
  description?: string;
  /** Path or absolute URL of the OG image. Defaults to /og/default.png */
  image?: string;
  /** Alt text for the OG image (Facebook/X use it). Defaults to the full title. */
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  /** Override hreflang alternates (e.g. blog posts without a translation). Defaults to pathname swap. */
  alternates?: { en?: string; es?: string };
  /** Extra JSON-LD objects to emit (BlogPosting, BreadcrumbList, ...) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { lang } = Astro.props;
const fallbackDescription =
  lang === 'es'
    ? 'Vicente Jorquera — Arquitecto de Software en consultoría de Arquitectura e IA. Escribo sobre arquitectura, IA y cloud.'
    : SITE.defaultTitle;

const {
  title,
  description = fallbackDescription,
  image = '/og/default.png',
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags,
  alternates,
  jsonLd,
  noindex = false,
} = Astro.props;

const t = alternatePaths(Astro.url.pathname);
const alts = {
  en: alternates?.en ?? t.en,
  es: alternates?.es ?? t.es,
};
// Missing side (untranslated post) → omit that alternate entirely
const xDefault = alts.en ?? alts.es;

const locale = SITE.locale[lang];
const defaultTitle =
  lang === 'es'
    ? 'Vicente Jorquera — Arquitecto de Software · Consultoría de Arquitectura e IA'
    : SITE.defaultTitle;
const fullTitle = title ? `${title} · ${SITE.name}` : defaultTitle;
const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = image.startsWith('http') ? image : absoluteUrl(image);
const altText = imageAlt ?? fullTitle;
const rssHref = SITE.rss[lang];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: lang === 'es' ? 'Arquitecto de Software' : 'Software Architect',
  description,
  worksFor: { '@type': 'Organization', name: 'Architecture & AI Consulting' }, // ⚠️ placeholder
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'INACAP' },
    { '@type': 'CollegeOrUniversity', name: 'INACAP — Técnico Analista Programador' },
  ],
  knowsAbout: ['Software Architecture', 'Artificial Intelligence', 'Cloud Architecture', 'Full-Stack Development', 'Technical Consulting'],
  sameAs: [SITE.github, SITE.linkedin, `https://x.com/${SITE.twitter.replace(/^@/, '')}`],
};

const webSiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: ['en', 'es'],
};

const ldBlocks: Record<string, unknown>[] = [personJsonLd, webSiteJsonLd];
if (jsonLd) ldBlocks.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
---

<!doctype html>
<html lang={locale.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    {/* hreflang — omit a side when there is no translation */}
    {alts.en && <link rel="alternate" hreflang="en" href={absoluteUrl(alts.en)} />}
    {alts.es && <link rel="alternate" hreflang="es" href={absoluteUrl(alts.es)} />}
    {xDefault && <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault)} />}

    <link rel="icon" type="image/webp" href="/1788373851761.webp" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — RSS (EN)`} href={absoluteUrl('/rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — RSS (ES)`} href={absoluteUrl('/es/rss.xml')} />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131416" />

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={altText} />
    <meta property="og:locale" content={locale.ogLocale} />
    {lang === 'en' && alts.es && <meta property="og:locale:alternate" content="es_CL" />}
    {lang === 'es' && alts.en && <meta property="og:locale:alternate" content="en_US" />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && <meta property="article:author" content={SITE.linkedin} />}
    {tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:creator" content={SITE.twitter} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={altText} />

    {/* Set theme class before first paint — no flash */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (_) {}
      })();
    </script>

    <ClientRouter />

    {ldBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    {SITE.cfAnalyticsToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${SITE.cfAnalyticsToken}"}`}></script>
    )}
  </head>

  <body class="flex min-h-dvh flex-col bg-bg font-sans text-ink antialiased">
    <Header lang={lang} alternates={alts} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
