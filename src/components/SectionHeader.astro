---
interface Props {
  kicker: string;
  title: string;
  href?: string;
  hrefLabel?: string;
}
const { kicker, title, href, hrefLabel } = Astro.props;
---

<div class="mb-7 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="kicker">{kicker}</p>
    <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{title}</h2>
  </div>
  {href && hrefLabel && (
    <a href={href} class="link-arrow">{hrefLabel} <span aria-hidden="true">→</span></a>
  )}
</div>
