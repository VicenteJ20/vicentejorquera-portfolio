---
import { SITE, type Lang } from '../consts';
import { useTranslations } from '../i18n/ui';
import { localizePath } from '../utils/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const home = localizePath('/', lang);
const archive = localizePath('/archive/', lang);
const blog = localizePath('/blog/', lang);
const products = localizePath('/products/', lang);
const certifications = localizePath('/certifications/', lang);

const socials = [
  { label: 'GitHub', href: SITE.github, icon: 'github' },
  { label: 'LinkedIn', href: SITE.linkedin, icon: 'linkedin' },
  { label: 'Email', href: `mailto:${SITE.email}`, icon: 'mail' },
  { label: 'RSS', href: SITE.rss[lang], icon: 'rss' },
];
---

<footer class="border-t border-line bg-surface/40">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid gap-10 md:grid-cols-12">
      {/* Brand + mission */}
      <div class="md:col-span-4">
        <a href={home} class="no-underline">
          <p class="font-display text-xl font-semibold tracking-tight text-ink">{SITE.name}</p>
          <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">{SITE.role[lang]}</p>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">{t('post.authorBio')}</p>
        <div class="mt-5 flex items-center gap-2">
          {socials.map((s) => (
            <a href={s.href} rel="me noopener" target={s.href.startsWith('http') ? '_blank' : undefined} aria-label={s.label}
               class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-accent">
              {s.icon === 'github' && (
                <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.12 3.04.74.8 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.66.41.35.77 1.05.77 2.11 0 1.52-.01 2.75-.01 3.12 0 .3.21.67.8.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
              )}
              {s.icon === 'linkedin' && (
                <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM4.5 9.75h1v11.25h-1zM10 9.75h.96v1.54h.01c.13-.25.46-.82 1.5-.82 1.6 0 2.65 1.04 2.65 3.01v7.52h-.99v-6.66c0-1.59-.58-2.68-2-2.68-1.5 0-2.13 1.09-2.13 2.68v6.66H10z"/></svg>
              )}
              {s.icon === 'mail' && (
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4.5 7 7.5 6 7.5-6"/></svg>
              )}
              {s.icon === 'rss' && (
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.2" fill="currentColor" stroke="none"/></svg>
              )}
            </a>
          ))}
        </div>
      </div>

      {/* Navigate */}
      <nav class="md:col-span-2" aria-label={t('footer.navigate')}>
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted">{t('footer.navigate')}</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-muted no-underline transition-colors hover:text-accent" href={blog}>{t('nav.blog')}</a></li>
          <li><a class="text-muted no-underline transition-colors hover:text-accent" href={archive}>{t('blog.archive')}</a></li>
          <li><a class="text-muted no-underline transition-colors hover:text-accent" href={products}>{t('nav.products')}</a></li>
          <li><a class="text-muted no-underline transition-colors hover:text-accent" href={certifications}>{t('nav.certifications')}</a></li>
        </ul>
      </nav>

      {/* Connect */}
      <div class="md:col-span-3">
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted">{t('footer.connect')}</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="font-mono text-[12px] text-muted no-underline transition-colors hover:text-accent" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a class="text-muted no-underline transition-colors hover:text-accent" href={SITE.github} rel="me noopener" target="_blank">github.com/{SITE.github.split('/').pop()}</a></li>
          <li><a class="text-muted no-underline transition-colors hover:text-accent" href={SITE.linkedin} rel="me noopener" target="_blank">linkedin.com/in/{SITE.linkedin.split('/').filter(Boolean).pop()}</a></li>
        </ul>
      </div>

      {/* Colophon */}
      <div class="md:col-span-3 md:justify-self-end">
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted">Colophon</p>
        <p class="mt-3 max-w-[16rem] text-xs leading-relaxed text-muted">{t('footer.colophon')}</p>
        <p class="mt-2 text-xs text-muted">{t('footer.madeIn')} ✳</p>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-line pt-6 font-mono text-[10.5px] uppercase tracking-[0.18em] text-muted sm:flex-row sm:items-center">
      <p>© {year} {SITE.name} — {t('footer.copyright')}</p>
      <p>ES <span aria-hidden="true">/</span> EN · vicentejorquera.dev</p>
    </div>
  </div>
</footer>
