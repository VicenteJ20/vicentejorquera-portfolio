---
/**
 * Home — hero + latest writing + products + trajectory + certifications.
 * All copy localized; all placeholder data marked in src/data/.
 */
import { SITE, type Lang } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import { getPosts, getProducts, localizePath } from '../../utils/content';
import { experience, education } from '../../data/experience';
import { certifications } from '../../data/certifications';
import PostCard from '../PostCard.astro';
import CertCard from '../CertCard.astro';
import SectionHeader from '../SectionHeader.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getPosts(lang)).slice(0, 3);
const products = await getProducts(lang);

const blog = localizePath('/blog/', lang);
const productsPath = localizePath('/products/', lang);
const certificationsPath = localizePath('/certifications/', lang);
---

{/* ============ HERO ============ */}
<section class="blueprint relative overflow-hidden border-b border-line">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 pb-16 pt-14 sm:px-8 sm:pt-20 lg:grid-cols-12 lg:items-center lg:gap-16 lg:pb-24">
    <div class="lg:col-span-7">
      <p class="kicker">{t('hero.kicker')}</p>
      <h1 class="mt-5 font-display font-semibold leading-[1.02] tracking-tight text-ink">
        <span class="block text-[clamp(2.7rem,7.2vw,4.4rem)]">{t('hero.line1')}</span>
        <span class="block text-[clamp(2.7rem,7.2vw,4.4rem)] italic text-accent">{t('hero.line2')}</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">{t('hero.tagline')}</p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={blog} class="btn btn-primary">{t('hero.ctaPrimary')}
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </a>
        <a href={`mailto:${SITE.email}`} class="btn btn-ghost">{t('hero.ctaSecondary')}</a>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[10.5px] uppercase tracking-[0.18em] text-muted">
        <span class="inline-flex items-center gap-2">
          <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-60"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span></span>
          {t('hero.availability')}
        </span>
        <span>{t('hero.location')} · UTC-3/4</span>
      </div>
    </div>

    {/* Architect's card — typographic, no photo required */}
    <div class="lg:col-span-5">
      <div class="relative mx-auto max-w-sm select-none" aria-hidden="true">
        <div class="absolute -inset-3 rounded-3xl border border-line bg-surface/60 blur-[1px]"></div>
        <div class="blueprint relative rounded-2xl border border-line-strong bg-surface p-7 shadow-[var(--shadow)]">
          <div class="flex items-start justify-between">
            <svg viewBox="0 0 40 40" width="46" height="46"><rect width="40" height="40" rx="9" fill="var(--accent)"/><text x="20" y="27.5" text-anchor="middle" font-family="'Fraunces Variable', Georgia, serif" font-weight="650" font-size="23" fill="var(--btn-ink)">V</text></svg>
            <p class="text-right font-mono text-[9px] uppercase leading-relaxed tracking-[0.22em] text-muted">vicente<br/>jorquera</p>
          </div>
          <p class="mt-8 font-display text-[5.2rem] font-semibold leading-none tracking-tighter text-ink">V<span class="text-accent">J</span></p>
          <div class="mt-8 space-y-2.5 border-t border-line pt-5 font-mono text-[10px] uppercase tracking-[0.16em] text-muted">
            <div class="flex justify-between gap-4"><span>role</span><span class="text-right text-ink-soft">{t('hero.cardCaption').split('·')[0].trim()}</span></div>
            <div class="flex justify-between gap-4"><span>focus</span><span class="text-right text-ink-soft">cloud · ai · arch</span></div>
            <div class="flex justify-between gap-4"><span>based</span><span class="text-right text-ink-soft">chile · utc-3/4</span></div>
            <div class="flex justify-between gap-4"><span>url</span><span class="text-right text-accent">vicentejorquera.dev</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ============ 01 — LATEST WRITING ============ */}
<section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20" aria-labelledby="latest-heading">
  <SectionHeader kicker={t('home.latestKicker')} title={t('home.latestTitle')} href={blog} hrefLabel={t('home.viewAll')} />
  {posts.length > 0 ? (
    <div class="border-t border-line">
      {posts.map((post) => <PostCard post={post} lang={lang} />)}
    </div>
  ) : (
    <p class="border-t border-line pt-8 font-mono text-sm text-muted">{t('blog.emptyTitle')}</p>
  )}
</section>

{/* ============ 02 — PRODUCTS ============ */}
<section class="border-t border-line bg-surface/30" aria-labelledby="products-heading">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <SectionHeader kicker={t('home.productsKicker')} title={t('home.productsTitle')} href={productsPath} hrefLabel={t('nav.products')} />
    {products.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <a href={localizePath(`/products/${product.id.replace(/^(en|es)\//, '')}/`, lang)} class="card card-hover group overflow-hidden no-underline">
            <div class="mono-tile h-28">
              <span class="relative z-10 font-display text-5xl font-semibold tracking-tighter">{product.data.name.charAt(0).toUpperCase()}</span>
            </div>
            <div class="p-5">
              <h3 class="font-display text-lg font-semibold text-ink transition-colors group-hover:text-accent-strong">{product.data.name}</h3>
              <p class="mt-1 text-sm leading-snug text-muted line-clamp-2">{product.data.tagline}</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {product.data.stack.slice(0, 4).map((s) => <span class="tag-pill">{s}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-line-strong p-10 text-center sm:p-14">
        <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-accent">// {t('common.soon')}</p>
        <h3 class="mt-3 font-display text-2xl font-semibold text-ink">{t('home.productsEmptyTitle')}</h3>
        <p class="mx-auto mt-3 max-w-md text-[15px] leading-relaxed text-muted">{t('home.productsEmptyBody')}</p>
        <a href={SITE.github} class="btn btn-ghost mt-6" target="_blank" rel="noopener">{t('home.productsEmptyCta')}
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
        </a>
      </div>
    )}
  </div>
</section>

{/* ============ 03 — TRAJECTORY ============ */}
<section class="mx-auto max-w-6xl border-t border-line px-5 py-16 sm:px-8 sm:py-20" aria-labelledby="experience-heading">
  <SectionHeader kicker={t('home.experienceKicker')} title={t('home.experienceTitle')} />
  <ol class="relative ml-1 space-y-9 border-l border-line-strong pl-7 sm:pl-9">
    {experience.map((item) => (
      <li class="relative">
        <span class:list={['absolute -left-[2.18rem] top-[0.35rem] h-2.5 w-2.5 rounded-full sm:-left-[2.68rem]', item.current ? 'bg-accent shadow-[0_0_10px_2px_var(--accent-glow)]' : 'border border-line-strong bg-bg']} aria-hidden="true"></span>
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <h3 class="font-display text-lg font-semibold leading-snug text-ink">{item.role[lang]}</h3>
          <p class="whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.18em] text-muted">{item.period[lang]}</p>
        </div>
        <p class="mt-0.5 font-mono text-[10px] uppercase tracking-[0.2em] text-accent-strong">{item.org}</p>
        <ul class="mt-3 list-disc space-y-1.5 pl-4 text-[14.5px] leading-relaxed text-muted marker:text-accent">
          {item.bullets[lang].map((b) => <li>{b}</li>)}
        </ul>
      </li>
    ))}
    {education.map((item) => (
      <li class="relative">
        <span class="absolute -left-[2.18rem] top-[0.35rem] h-2.5 w-2.5 rounded-full border border-accent bg-transparent sm:-left-[2.68rem]" aria-hidden="true"></span>
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <h3 class="font-display text-lg font-semibold leading-snug text-ink-soft">{item.degree[lang]}</h3>
          <p class="whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.18em] text-muted">{item.school}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

{/* ============ 04 — CERTIFICATIONS ============ */}
<section class="border-t border-line" aria-labelledby="certifications-heading">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <SectionHeader kicker={t('home.certsKicker')} title={t('home.certsTitle')} href={certificationsPath} hrefLabel={t('home.certsViewAll')} />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {certifications.map((cert) => <CertCard cert={cert} lang={lang} />)}
    </div>
  </div>
</section>
