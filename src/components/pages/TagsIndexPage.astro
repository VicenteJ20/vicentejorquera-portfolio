---
import type { Lang } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import { collectTags, getPosts, localizePath } from '../../utils/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getPosts(lang);
const tags = [...collectTags(posts).entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<section class="shell py-14 sm:py-20">
  <p class="kicker">{t('blog.tagsKicker')}</p>
  <h1 class="mt-4 font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl">{t('blog.tagsTitle')}</h1>
  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{t('meta.tagsDescription')}</p>

  <div class="mt-12 flex flex-wrap gap-3">
    {tags.map(([slug, count]) => (
      <a href={localizePath(`/tags/${slug}/`, lang)} class="tag-pill !px-4 !py-2 !text-[11px]">
        #{slug} <span class="opacity-60">· {count}</span>
      </a>
    ))}
    {tags.length === 0 && <p class="text-muted">{t('blog.emptyTitle')}</p>}
  </div>
</section>
