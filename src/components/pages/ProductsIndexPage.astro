---
import { SITE, type Lang } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import { formatDate, getProducts, localizePath, slugOf, tileStyle } from '../../utils/content';
import SectionHeader from '../SectionHeader.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const products = await getProducts(lang);
---

<section class="shell py-14 sm:py-20">
  <p class="kicker">{t('products.kicker')}</p>
  <h1 class="mt-4 font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl">{t('products.title')}</h1>
  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{t('products.subtitle')}</p>

  {products.length > 0 ? (
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {products.map((product) => (
        <a href={localizePath(`/products/${slugOf(product)}/`, lang)} class="card card-hover group overflow-hidden no-underline">
          <div class="mono-tile h-36" style={tileStyle(product.data)}>
            {product.data.tileText ? (
              <span class="relative z-10 px-4 text-center font-display text-4xl font-semibold leading-tight tracking-tight">{product.data.tileText}</span>
            ) : (
              <span class="relative z-10 font-display text-6xl font-semibold tracking-tighter">{product.data.name.charAt(0).toUpperCase()}</span>
            )}
          </div>
          <div class="p-6">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-display text-2xl font-semibold text-ink transition-colors group-hover:text-accent-strong">{product.data.name}</h2>
              <span class="whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.18em] text-muted">{formatDate(product.data.released, lang)}</span>
            </div>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{product.data.tagline}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {product.data.stack.map((s) => <span class="tag-pill">{s}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="mt-12 rounded-2xl border border-dashed border-line-strong px-8 py-16 text-center sm:py-20">
      <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-accent">// {t('common.soon')}</p>
      <h2 class="mt-3 font-display text-3xl font-semibold text-ink">{t('products.emptyTitle')}</h2>
      <p class="mx-auto mt-3 max-w-md leading-relaxed text-muted">{t('products.emptyBody')}</p>
      <a href={SITE.github} class="btn btn-ghost mt-7" target="_blank" rel="noopener">GitHub
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
      </a>
    </div>
  )}
</section>
