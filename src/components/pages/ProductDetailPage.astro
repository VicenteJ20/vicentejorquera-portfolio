---
import { render } from 'astro:content';
import { SITE, type Lang } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import { formatDate, localizePath, slugOf, type Product } from '../../utils/content';

interface Props {
  lang: Lang;
  product: Product;
}
const { lang, product } = Astro.props;
const t = useTranslations(lang);

const { Content } = await render(product);
const slug = slugOf(product);
---

<article class="shell py-14 sm:py-20">
  <div class="max-w-3xl">
  <a href={localizePath('/products/', lang)} class="font-mono text-[11px] uppercase tracking-[0.2em] text-muted no-underline transition-colors hover:text-accent">{t('products.detailBack')}</a>

  <header class="mt-6">
    <p class="kicker">// product</p>
    <h1 class="mt-3 font-display text-5xl font-semibold tracking-tight text-ink">{product.data.name}</h1>
    <p class="mt-3 text-xl leading-snug text-ink-soft">{product.data.tagline}</p>
    <p class="mt-2 text-muted">{product.data.description}</p>

    {/* Facts panel */}
    <div class="mt-6 grid gap-4 rounded-2xl border border-line bg-surface p-6 text-sm sm:grid-cols-3">
      <div>
        <p class="font-mono text-[9px] uppercase tracking-[0.22em] text-muted">{t('products.released')}</p>
        <p class="mt-1.5 text-ink-soft">{formatDate(product.data.released, lang)}</p>
      </div>
      <div class="sm:col-span-2">
        <p class="font-mono text-[9px] uppercase tracking-[0.22em] text-muted">{t('products.stack')}</p>
        <div class="mt-1.5 flex flex-wrap gap-1.5">
          {product.data.stack.map((s) => <span class="tag-pill">{s}</span>)}
        </div>
      </div>
    </div>

    {/* Actions */}
    <div class="mt-6 flex flex-wrap gap-3">
      {product.data.download && (
        <a href={product.data.download} class="btn btn-primary" target="_blank" rel="noopener">{t('common.download')}
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 19h16"/></svg>
        </a>
      )}
      {product.data.repo && (
        <a href={product.data.repo} class="btn btn-ghost" target="_blank" rel="noopener">{t('common.viewRepo')}</a>
      )}
      {product.data.website && (
        <a href={product.data.website} class="btn btn-ghost" target="_blank" rel="noopener">{t('common.visitSite')}</a>
      )}
    </div>
  </header>

  <div class="post-body mt-10">
    <Content />
  </div>
  </div>
</article>
