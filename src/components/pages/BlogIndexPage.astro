---
import { SITE, type Lang } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import { collectTags, getPosts, localizePath } from '../../utils/content';
import PostCard from '../PostCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getPosts(lang);
const tags = [...collectTags(posts).entries()].sort((a, b) => b[1] - a[1]);
const archive = localizePath('/archive/', lang);
---

<section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
  <p class="kicker">{t('blog.kicker')}</p>
  <h1 class="mt-4 font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl">{t('blog.title')}</h1>
  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{t('blog.subtitle')}</p>

  {/* Tag quick filters */}
  {tags.length > 0 && (
    <div class="mt-8 flex flex-wrap items-center gap-2">
      <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted">{t('blog.filterByTag')}:</span>
      {tags.map(([slug, count]) => (
        <a class="tag-pill" href={localizePath(`/tags/${slug}/`, lang)}>{slug} · {count}</a>
      ))}
    </div>
  )}

  <div class="mt-10 border-t border-line">
    {posts.length > 0 ? posts.map((post) => <PostCard post={post} lang={lang} />) : (
      <div class="py-14 text-center">
        <p class="font-display text-2xl font-semibold text-ink">{t('blog.emptyTitle')}</p>
        <p class="mx-auto mt-2 max-w-md text-muted">{t('blog.emptyBody')}</p>
      </div>
    )}
  </div>

  <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
    <a href={SITE.rss[lang]} class="link-arrow">{t('common.subscribe')} {t('common.rss')} <span aria-hidden="true">→</span></a>
    <a href={archive} class="link-arrow">{t('blog.archive')} <span aria-hidden="true">→</span></a>
  </div>
</section>
