---
import type { Lang } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import { formatDate, getPosts, localizePath, slugOf } from '../../utils/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getPosts(lang);
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
  <p class="kicker">{t('blog.archiveKicker')}</p>
  <h1 class="mt-4 font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl">{t('blog.archive')}</h1>
  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{t('blog.archiveTitle')}</p>

  {years.map((year) => (
    <div class="mt-12">
      <div class="flex items-baseline gap-4 border-b border-line pb-3">
        <h2 class="font-display text-3xl font-semibold tracking-tight text-accent">{year}</h2>
        <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted">{byYear.get(year)!.length} posts</span>
      </div>
      <ul>
        {byYear.get(year)!.map((post) => (
          <li>
            <a href={localizePath(`/blog/${slugOf(post)}/`, lang)} class="leader-row group border-b border-line py-3.5 no-underline">
              <span class="w-28 shrink-0 font-mono text-[11px] uppercase tracking-wider text-muted">{formatDate(post.data.pubDate, lang).split(',')[0]}</span>
              <span class="font-display text-lg font-medium leading-snug text-ink transition-colors group-hover:text-accent-strong">{post.data.title}</span>
              <span class="leader" aria-hidden="true"></span>
              <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted transition-colors group-hover:text-accent">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}

  {years.length === 0 && <p class="mt-14 border-t border-line pt-8 text-muted">{t('blog.emptyTitle')}</p>}
</section>
