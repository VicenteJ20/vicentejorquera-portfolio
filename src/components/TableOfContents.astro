---
/**
 * Table of contents built from the headings Astro extracts at render time.
 * Sticky column on xl screens; collapsible <details> on smaller ones.
 */
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../consts';

interface Heading { depth: number; slug: string; text: string }
interface Props {
  headings: Heading[];
  lang: Lang;
}
const { headings, lang } = Astro.props;
const t = useTranslations(lang);

const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 1 && (
  <nav class="toc font-mono text-[11.5px] leading-relaxed" aria-label={t('post.toc')}>
    <p class="text-[10px] uppercase tracking-[0.22em] text-muted">{t('post.toc')}</p>
    <ul class="mt-3 border-l border-line pl-0">
      {items.map((h) => (
        <li class={h.depth === 3 ? 'ml-4' : ''}>
          <a href={`#${h.slug}`} data-toc-link={h.slug}
             class="toc-link -ml-px block border-l border-transparent py-1.5 pl-4 text-muted no-underline transition-colors hover:text-ink">
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
