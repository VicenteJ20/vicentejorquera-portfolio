---
import { SITE, type Lang } from '../consts';
import { useTranslations } from '../i18n/ui';
import { localizePath } from '../utils/content';

interface Props {
  lang: Lang;
  alternates: { en: string; es: string };
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;

const home = localizePath('/', lang);
const blog = localizePath('/blog/', lang);
const products = localizePath('/products/', lang);
const certifications = localizePath('/certifications/', lang);
const rss = SITE.rss[lang];

// Language switch targets — always the same page in the other language
const switchTo = lang === 'en' ? alternates.es : alternates.en;
const switchLabel = lang === 'en' ? 'ES' : 'EN';
const switchAria = lang === 'en' ? 'Cambiar a Español' : 'Switch to English';

const navItems = [
  { href: blog, label: t('nav.blog'), active: path.startsWith(blog) },
  { href: products, label: t('nav.products'), active: path.startsWith(products) },
  { href: certifications, label: t('nav.certifications'), active: path.startsWith(certifications) },
];
---

<header class="site-header relative">
  <div class="shell flex items-center justify-between gap-4 py-4 sm:py-5">
    {/* Brand */}
    <a href={home} class="group flex min-w-0 items-center gap-3 no-underline" aria-label={SITE.name}>
      <img src="/1788373851761.webp" width="34" height="34" alt="" aria-hidden="true" class="h-[34px] w-[34px] shrink-0 rounded-[9px] object-cover transition-transform duration-300 group-hover:-rotate-3" />
      <span class="hidden min-w-0 flex-col leading-none sm:flex">
        <span class="truncate font-display text-[15px] font-semibold tracking-tight text-ink">{SITE.name}</span>
        <span class="mt-1 font-mono text-[8.5px] uppercase leading-none tracking-[0.18em] text-muted">{SITE.role[lang]}</span>
      </span>
    </a>

    {/* Nav + controls */}
    <div class="flex shrink-0 items-center gap-2 sm:gap-4">
      <nav class="hidden items-center gap-3 nav:flex nav:gap-5" aria-label="Main">
        {navItems.map((item) => (
          <a href={item.href} class="nav-link" aria-current={item.active ? 'true' : undefined}>{item.label}</a>
        ))}
      </nav>

      <span class="hidden h-4 w-px bg-line-strong nav:block" aria-hidden="true"></span>

      {/* RSS */}
      <a href={rss} class="hidden h-9 w-9 items-center justify-center rounded-full border border-transparent text-muted transition-colors hover:border-line-strong hover:text-accent nav:flex" aria-label="RSS feed">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1.2" fill="currentColor" stroke="none" />
        </svg>
      </a>

      {/* Language switch */}
      <a href={switchTo} hreflang={lang === 'en' ? 'es' : 'en'} class="flex h-9 items-center gap-1.5 rounded-full border border-line-strong px-2.5 font-mono text-[11px] font-semibold tracking-widest text-ink no-underline transition-colors hover:border-accent hover:text-accent" aria-label={switchAria}>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a14.5 14.5 0 0 1 0 18" /><path d="M12 3a14.5 14.5 0 0 0 0 18" />
        </svg>
        {switchLabel}
      </a>

      {/* Theme toggle */}
      <button type="button" data-theme-toggle class="flex h-9 w-9 items-center justify-center rounded-full border border-line-strong text-ink transition-colors hover:border-accent hover:text-accent" aria-label="Toggle color theme">
        <svg class="icon-sun hidden h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5 5l1.8 1.8M17.2 17.2 19 19M19 5l-1.8 1.8M6.8 17.2 5 19" />
        </svg>
        <svg class="icon-moon hidden h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.4 14.5A8.5 8.5 0 0 1 9.5 3.6a8.5 8.5 0 1 0 10.9 10.9Z" />
        </svg>
      </button>

      {/* Menu toggle — below the nav breakpoint (850px) */}
      <button type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-nav" class="flex h-9 w-9 items-center justify-center rounded-full border border-line-strong text-ink transition-colors hover:border-accent hover:text-accent nav:hidden" aria-label="Toggle menu">
        <svg class="icon-menu h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" />
        </svg>
        <svg class="icon-close hidden h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12" /><path d="M18 6 6 18" />
        </svg>
      </button>
    </div>
  </div>

  {/* Collapsible nav — below the nav breakpoint (850px) */}
  <div id="mobile-nav" class="mobile-nav border-t border-line nav:hidden" hidden>
    <nav class="shell flex flex-col py-3" aria-label="Mobile">
      {navItems.map((item) => (
        <a href={item.href} aria-current={item.active ? 'true' : undefined} class="mobile-nav-link">{item.label}</a>
      ))}
      <a href={rss} class="mobile-nav-link">RSS</a>
    </nav>
  </div>
</header>

{/* Keep <html> .dark in sync across view transitions */}
<script>
  function applyStoredTheme() {
    try {
      var stored = localStorage.getItem('theme');
      var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
      syncThemeIcons();
    } catch (_) {}
  }
  function syncThemeIcons() {
    var dark = document.documentElement.classList.contains('dark');
    document.querySelectorAll('.icon-sun').forEach((el) => el.classList.toggle('hidden', dark));
    document.querySelectorAll('.icon-moon').forEach((el) => el.classList.toggle('hidden', !dark));
  }
  syncThemeIcons();

  // Mobile menu — open/close, Escape, outside click, close on navigation
  function syncMenuIcons(open) {
    document.querySelectorAll('[data-menu-toggle]').forEach((btn) => {
      btn.setAttribute('aria-expanded', String(open));
      const menuIcon = btn.querySelector('.icon-menu');
      const closeIcon = btn.querySelector('.icon-close');
      if (menuIcon) menuIcon.classList.toggle('hidden', open);
      if (closeIcon) closeIcon.classList.toggle('hidden', !open);
    });
  }
  function closeMenu() {
    const panel = document.getElementById('mobile-nav');
    if (panel) panel.hidden = true;
    syncMenuIcons(false);
  }
  if (!document.documentElement.hasAttribute('data-menu-delegate')) {
    document.documentElement.setAttribute('data-menu-delegate', 'true');
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const btn = target.closest('[data-menu-toggle]');
      const panel = document.getElementById('mobile-nav');
      if (btn) {
        if (!panel) return;
        panel.hidden = !panel.hidden;
        syncMenuIcons(!panel.hidden);
        return;
      }
      // Tapping a link inside the menu navigates — close it
      if (panel && !panel.hidden && target.closest('#mobile-nav a')) {
        closeMenu();
        return;
      }
      // Clicking outside the menu closes it
      if (panel && !panel.hidden && !target.closest('#mobile-nav') && !target.closest('[data-menu-toggle]')) {
        closeMenu();
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });
    document.addEventListener('astro:after-swap', closeMenu);
  }

  // One delegated listener survives client-side navigations
  if (!document.documentElement.hasAttribute('data-theme-delegate')) {
    document.documentElement.setAttribute('data-theme-delegate', 'true');
    document.addEventListener('click', (event) => {
      var btn = (event.target as Element | null)?.closest?.('[data-theme-toggle]');
      if (!btn) return;
      var dark = !document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark', dark);
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (_) {}
      syncThemeIcons();
      window.dispatchEvent(new CustomEvent('themechange', { detail: { dark } }));
    });
    document.addEventListener('astro:after-swap', applyStoredTheme);
  }
</script>
